[Unit]
Description=Run udhcpc service for %I
DefaultDependencies=no
After=wifi-modules.service
Requires=wifi-modules.service

[Service]
Type=simple
ExecStart=/sbin/udhcpc -i %I -s /usr/share/udhcpc/default.script -f -p /run/udhcpc.%I.pid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
