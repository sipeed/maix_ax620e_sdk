[Unit]
Description=Run udhcpc service
DefaultDependencies=no
After=boot.mount wifi.service
Requires=boot.mount wifi.service
PartOf=wifi.service
ConditionPathExists=!/boot/wifi.ap
ConditionPathExists=!/boot/wifi.mon

[Service]
Type=simple
ExecStart=/sbin/udhcpc -i wlan0 -s /usr/share/udhcpc/default.script -f -p /run/udhcpc.wlan0.pid
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
